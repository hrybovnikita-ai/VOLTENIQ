# Copy values into backend/.env and frontend/.env for local development.
# On Vercel, set secrets in the project Environment Variables UI — never commit real secrets.

# Neon (`neon deploy` / `neon env pull`) writes secrets into ignored `.env.local`:
# DATABASE_URL              pooled Postgres (app runtime)
# DATABASE_URL_UNPOOLED     direct Postgres (Prisma migrate / db push)
# NEON_BRANCH / NEON_BRANCH_ID / NEON_FUNCTION_HOST_SUFFIX

# --- Backend (service: backend) ---
# DEMO_MODE=false
# JWT_SECRET=long-random-secret
# CORS_ORIGIN=https://your-production-domain.com
# APP_ORIGIN=https://your-production-domain.com
# RESEND_API_KEY=re_...
# MAIL_FROM="VOLTENIQ <noreply@your-domain.com>"
# FIREBASE_PROJECT_ID=volteniq
# NODE_ENV=production
# Never set AUTH_TEST_RETURN_TOKEN in production.

# --- Frontend (service: frontend, build-time) ---
# VITE_API_URL=/api
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...   (backend / Vercel only — never VITE_)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Local docker-compose Postgres defaults:
# POSTGRES_USER=volteniq
# POSTGRES_PASSWORD=volteniq
# POSTGRES_DB=volteniq
