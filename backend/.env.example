PORT=5004
NODE_ENV=development

# Set to true for in-memory catalog and order data; accounts always require PostgreSQL
DEMO_MODE=false

# PostgreSQL connection for all accounts
DATABASE_URL="postgresql://volteniq:volteniq@localhost:5432/volteniq?schema=public"

# Legacy JWT settings are unused; auth uses HttpOnly session cookies (30 days).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (credentials/cookies require exact origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Production cross-site cookies only: set SESSION_SAME_SITE=none (also forces Secure)
# SESSION_SAME_SITE=lax

# Firebase project ID (must match frontend VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=volteniq
