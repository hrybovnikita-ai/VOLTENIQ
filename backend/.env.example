PORT=5004
NODE_ENV=development

# Set to true for in-memory catalog and order data; accounts always require PostgreSQL
DEMO_MODE=false

# Local PostgreSQL (docker compose) or hosted Neon connection string.
# On Vercel/Neon prefer the pooled connection string with sslmode=require.
# Never commit the real DATABASE_URL.
DATABASE_URL="postgresql://volteniq:volteniq@localhost:5432/volteniq?schema=public"

# Legacy JWT settings are unused; auth uses HttpOnly session cookies (30 days).
# Still set a strong secret in production to avoid relying on the demo fallback.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (credentials/cookies require exact origins).
# Local:
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Production example (set in Vercel dashboard, not in git):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-custom-domain.com

# Same-origin Vercel Services (frontend + /api rewrite) should leave this unset (SameSite=Lax + __Host- cookie).
# Only for a separate API hostname: SESSION_SAME_SITE=none
# SESSION_SAME_SITE=lax

# Firebase project ID (must match frontend VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=volteniq
