PORT=5000
NODE_ENV=development

# Set to true to run without PostgreSQL (in-memory demo data)
DEMO_MODE=true

# PostgreSQL connection (used when DEMO_MODE=false)
DATABASE_URL="postgresql://volteniq:volteniq@localhost:5432/volteniq?schema=public"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Firebase project ID (must match frontend VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=volteniq
