PORT=5004
NODE_ENV=development

# Set to true for in-memory catalog and order data; accounts always require PostgreSQL
DEMO_MODE=false

# Prefer Neon root `.env.local` from `neon deploy` / `neon env pull` (overrides these).
# DATABASE_URL = pooled (-pooler) for the app; DATABASE_URL_UNPOOLED = direct for Prisma migrate.
# Never commit real Neon credentials.
DATABASE_URL="postgresql://volteniq:volteniq@localhost:5432/volteniq?schema=public"
DATABASE_URL_UNPOOLED="postgresql://volteniq:volteniq@localhost:5432/volteniq?schema=public"

# Legacy JWT settings are unused; auth uses HttpOnly session cookies (30 days).
# Still set a strong secret in production to avoid relying on the demo fallback.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (credentials/cookies require exact origins).
# Local:
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Production example (set in Vercel dashboard, not in git):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-custom-domain.com

# Same-origin Vercel Services (frontend + /api rewrite) should leave this unset (SameSite=Lax + __Host- cookie).
# Only for a separate API hostname: SESSION_SAME_SITE=none
# SESSION_SAME_SITE=lax

# Auth provider: firebase (default) or clerk. Must match frontend VITE_AUTH_PROVIDER.
AUTH_PROVIDER=firebase

# Clerk secret — server only. Required only when AUTH_PROVIDER=clerk.
CLERK_SECRET_KEY=

# Firebase project ID — required when AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=volteniq
# Optional override for the /__/auth + /__/firebase same-origin proxy target
# (defaults to https://${FIREBASE_PROJECT_ID}.firebaseapp.com).
# FIREBASE_AUTH_PROXY_TARGET=https://volteniq.firebaseapp.com

# Public web API key from the same Firebase project as the storefront.
FIREBASE_WEB_API_KEY=

# App origin used in verification / reset email links.
APP_ORIGIN=http://localhost:5173

# Real email delivery (required for password signup / recovery in non-test environments).
# Do not deploy password-auth flows to production until these are set and a test email succeeds.
RESEND_API_KEY=
MAIL_FROM="VOLTENIQ <onboarding@resend.dev>"

# Local/CI only: skip Resend and return raw tokens in register responses. Never enable in production.
# AUTH_TEST_RETURN_TOKEN=1
