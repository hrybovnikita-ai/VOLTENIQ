generator client {
  provider      = "prisma-client-js"
  // native = local machines; rhel-openssl-3.0.x = Vercel Node.js functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled Neon URL for app queries (hostname contains -pooler).
  url       = env("DATABASE_URL")
  // Direct Neon URL for migrations / introspection (neon env: DATABASE_URL_UNPOOLED).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model User {
  sessions          Session[]
  authTokens        AuthToken[]
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  password          String
  emailVerifiedAt   DateTime?
  avatarUrl         String?
  googleId          String?            @unique
  firebaseUid       String?            @unique
  clerkId           String?            @unique
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cart              Cart?
  orders            Order[]
  favorites         Favorite[]
  priceAlerts       PriceAlert[]
  notifications     Notification[]
  chatConversations ChatConversation[]
  reviews           Review[]
  promoRedemptions  PromoRedemption[]
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int      @default(0)
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New chat")
  pinned    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, pinned, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  category       String
  brand          String   @default("Apple")
  price          Float
  compareAt      Float?
  image          String
  images         String[]
  colors         String[]
  storage        String[]
  ram            String[] @default([])
  size           String[] @default([])
  colorImages    Json?
  variantImages  Json?
  options        Json?
  concept        Boolean @default(false)
  chip           String[] @default([])
  model          String[] @default([])
  case           String[] @default([])
  connectivity   String[] @default([])
  material       String[] @default([])
  band           String[] @default([])
  compatible     String[] @default([])
  variantPricing Json?
  specs          Json
  stock          Int      @default(25)
  featured       Boolean  @default(false)
  rating         Float    @default(4.8)
  reviewCount    Int      @default(120)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
  favorites      Favorite[]
  priceAlerts    PriceAlert[]
  priceHistory   PriceHistory[]
  reviews        Review[]
}

model PriceAlert {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscribedPrice  Float
  targetPrice      Float?
  notified         Boolean   @default(false)
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([userId, productId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float
  recordedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  productId String?
  orderId   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Order {
  id                String             @id @default(cuid())
  orderNumber       String?            @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            OrderStatus        @default(PENDING)
  subtotal          Float?
  discountAmount    Float              @default(0)
  total             Float
  promoCodeId       String?
  promoCode         PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeSnapshot String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  trackingDemoNote  String             @default("Simulated tracking for the VOLTENIQ demo store — no real shipment.")
  shippingName      String
  shippingAddress   String
  shippingCity      String
  shippingZip       String
  shippingCountry   String             @default("Demo Country")
  demoNote          String             @default("DEMO ORDER — no real payment processed")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             OrderItem[]
  statusHistory     OrderStatusEvent[]
  promoRedemption   PromoRedemption?

  @@index([userId, createdAt])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  photos    String[]
  verified  Boolean      @default(false)
  status    ReviewStatus @default(APPROVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
}

model PromoCode {
  id             String           @id @default(cuid())
  code           String           @unique
  description    String?
  type           DiscountType
  value          Float
  minOrderAmount Float            @default(0)
  maxUses        Int?
  usedCount      Int              @default(0)
  perUserLimit   Int              @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean          @default(true)
  productIds     String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orders         Order[]
  redemptions    PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  createdAt   DateTime  @default(now())

  @@index([promoCodeId, userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  color     String?
  storage   String?
  ram       String?
  size      String?
  configuration Json?
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
