{
  "name": "volteniq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate dev --name init && node prisma/seed.js",
    "mongo:check": "node scripts/mongo-check.js",
    "mongo:sync": "node scripts/mongo-sync.js",
    "mongo": "node scripts/mongo-check.js",
    "mongo:setup": "node scripts/mongo-setup.js",
    "test:auth": "node --test test/auth.test.js",
    "test:security": "node --test test/security.test.js",
    "test:checkout": "node --test test/checkout.test.js",
    "test:chat": "node --test test/chat.test.js",
    "test:security:integration": "node test/security-integration.js",
    "security:check": "node scripts/security-check.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0"
  }
}
