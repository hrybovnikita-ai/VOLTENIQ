# Same-origin API via Vercel Services rewrite (or Vite proxy in local dev).
# Do not use http://localhost:... in production builds.
VITE_API_URL=/api

# Auth provider: firebase (default Google via Firebase popup) or clerk.
# Must match backend AUTH_PROVIDER. Leave as firebase unless intentionally using Clerk.
VITE_AUTH_PROVIDER=firebase

# Clerk publishable key only (never put CLERK_SECRET_KEY here). Required only when VITE_AUTH_PROVIDER=clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# Firebase web config — required for Google sign-in when VITE_AUTH_PROVIDER=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
