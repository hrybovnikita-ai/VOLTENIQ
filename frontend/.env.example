# Same-origin API via Vercel Services rewrite (or Vite proxy in local dev).
# Do not use http://localhost:... in production builds.
VITE_API_URL=/api

# Clerk publishable key only (never put CLERK_SECRET_KEY here)
VITE_CLERK_PUBLISHABLE_KEY=

# Firebase web config (optional fallback Google auth when Clerk is unset)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
